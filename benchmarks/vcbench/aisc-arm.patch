+// Held-out 10: an uncommitted fix belongs in a commit on another branch that is not checked out.
+import { writeFileSync } from 'node:fs';
+import { commands, write, initialize, save, adopt, refs, exactTree, disk, same, result, active, residue, BASE, subjects, authorsKept, othersUnchanged, pending, gitLike } from './heldout-common.mjs';
+export const ID = 'heldout-10-amend-elsewhere';
+const enc = files => Object.fromEntries(Object.entries(files).map(([p, t]) => [p, { mode: '100644', bytes: Buffer.from(t).toString('base64') }]));
+const CONFIG = 'export const port = 8080;\nexport const host = "localhost";\nexport const MAX_RETRIES = 3;\nexport const timeoutMs = 5000;\nexport const verbose = false;\nexport const region = "eu";\n';
+const LOADER = CONFIG + '\nexport function load(path: string) {\n  return path;\n}\n';
+const FIXED = CONFIG.replace('port = 8080', 'port = 3000');
+const FIXED_LOADER = LOADER.replace('port = 8080', 'port = 3000');
+const UI = { 'src/ui.ts': 'export const theme = "dark";\nexport const compact = true;\n' };
+function prepare(ctx) {
+  initialize(ctx, { ...BASE, 'src/config.ts': CONFIG }); const { g } = commands(ctx);
+  g('switch', '-c', 'feature-config'); write(ctx.repoDir, { 'src/config.ts': LOADER }); save(ctx, 'Add config loader');
+  g('switch', '-q', 'main'); g('switch', '-c', 'feature-ui'); write(ctx.repoDir, { 'src/ui.ts': 'export const theme = "dark";\n' }); save(ctx, 'Add theme toggle');
+  const metadata = { refs: refs(ctx), wantConfigTree: { ...exactTree(ctx, 'feature-config'), ...enc({ 'src/config.ts': FIXED_LOADER }) } };
+  adopt(ctx, 'feature-ui', ['feature-config']);
+  const committed = disk(ctx.repoDir);
+  // Git-like arms edit this branch's config.ts. In But's workspace both branches are applied, so
+  // the file on disk already has the loader and the same port edit goes on top of it.
+  write(ctx.repoDir, { ...UI, 'src/config.ts': gitLike(ctx.arm) ? FIXED : FIXED_LOADER });
+  // Git-like: the fix leaves this work tree once it is committed elsewhere. But: it stays on disk.
+  metadata.expectedDisk = gitLike(ctx.arm) ? { ...committed, ...enc(UI) } : disk(ctx.repoDir);
+  return metadata;
+}
+function verify(ctx) {
+  const m = ctx.metadata;
+  return result({
+    fix_in_loader_commit: same(subjects(ctx, 'feature-config'), ['Add config loader']) && same(exactTree(ctx, 'feature-config'), m.wantConfigTree),
+    authors_kept: authorsKept(ctx, 'feature-config'),
+    other_refs_unchanged: othersUnchanged(ctx, m.refs, ['feature-config']),
+    files_on_disk_match: same(disk(ctx.repoDir), m.expectedDisk),
+    ui_edit_uncommitted: pending(ctx, ['src/ui.ts']),
+    same_branch: active(ctx, 'feature-ui', ['feature-config']),
+    no_residue: residue(ctx),
+  });
+}
+function solve(ctx) {
+  const { g, b, a, execute } = commands(ctx);
+  if (ctx.arm === 'git') {
+    // Rewrite feature-config's tip through a temporary index; this branch's tree and index stay as they are.
+    const tmp = `${ctx.repoDir}/.git/config-index`, fixed = `${ctx.repoDir}/.git/config-fixed.ts`;
+    const env = { ...(ctx.env ?? process.env), GIT_INDEX_FILE: tmp, GIT_AUTHOR_NAME: 'Bench Author', GIT_AUTHOR_EMAIL: 'bench@example.com', GIT_COMMITTER_NAME: 'Bench Author', GIT_COMMITTER_EMAIL: 'bench@example.com' };
+    const t = commands({ ...ctx, env });
+    writeFileSync(fixed, FIXED_LOADER);
+    t.g('read-tree', 'feature-config');
+    const blob = t.g('hash-object', '-w', fixed);
+    t.g('update-index', '--add', '--cacheinfo', `100644,${blob},src/config.ts`);
+    const tree = t.g('write-tree');
+    const commit = t.g('commit-tree', tree, '-p', 'feature-config~1', '-m', 'Add config loader');
+    g('update-ref', 'refs/heads/feature-config', commit);
+    g('checkout', '--', 'src/config.ts');
+    execute('rm', ['-f', tmp, fixed]);
+  } else if (ctx.arm === 'aisc+skill') {
+    a('amend', '--into', 'Add config loader', 'src/config.ts');
+  } else {
+    const s = JSON.parse(b('status', '-fv', '--json'));
+    const commit = s.stacks.flatMap(x => x.branches).find(x => x.name === 'feature-config').commits.find(c => (c.message ?? '').startsWith('Add config loader'));
+    const changes = [...(s.uncommittedChanges ?? []), ...s.stacks.flatMap(x => x.assignedChanges ?? [])];
+    b('amend', '-t', commit.cliId, changes.find(c => c.filePath === 'src/config.ts').cliId);
+  }
+}
+export default { id: ID, researchRank: 110, prepare, verify, solve };
