@@ -0,0 +1,33 @@
+// Shared fixture and verification helpers for the held-out tasks (heldout-1 .. heldout-6).
+// Written and frozen before any agent ran them; see benchmarks/agents/heldout in the AISC repo.
+import { gitLike } from './arms.mjs';
+import { commands, write, initialize, save, adopt, refs, exactTree, disk, same, result, active, residue, butChanges } from './scenario-cleanup.mjs';
+export { gitLike, commands, write, initialize, save, adopt, refs, exactTree, disk, same, result, active, residue, butChanges };
+
+export const BASE = {
+  'README.md': 'Service example.\n',
+  'src/app.ts': 'export const name = "service";\n',
+  'src/config.ts': 'export const port = 8080;\nexport const MAX_RETRIES = 3;\n',
+  'docs/api.md': '# API\n\nGET /items lists items.\n',
+};
+// Subjects of BRANCH's commits above main, newest first.
+export const subjects = (ctx, branch, base = 'main') => {
+  const out = commands(ctx).g('log', '--format=%s', `${base}..${branch}`);
+  return out ? out.split('\n') : [];
+};
+// Every commit on BRANCH above main still has the fixture author and committer identity.
+export const authorsKept = (ctx, branch, base = 'main') =>
+  commands(ctx).g('log', '--format=%an <%ae>', `${base}..${branch}`).split('\n').filter(Boolean).every(line => line === 'Bench Author <bench@example.com>');
+// Refs other than the ones the task may change are byte-identical.
+export function othersUnchanged(ctx, before, mayChange) {
+  const now = refs(ctx);
+  const pick = r => Object.fromEntries(Object.entries(r).filter(([name]) => !mayChange.includes(name)));
+  return same(pick(now), pick(before));
+}
+// "Uncommitted" in the tool's own model: Git's index for git-like arms, But's change lists.
+export function pending(ctx, paths) {
+  const { g } = commands(ctx);
+  if (gitLike(ctx.arm)) return paths.every(p => g('diff', '--cached', '--name-only', '--', p) === '' && g('status', '--porcelain', '--', p) !== '');
+  const b = butChanges(ctx);
+  return !!b && paths.every(p => b.uncommitted.includes(p) || b.assigned.includes(p));
+}
