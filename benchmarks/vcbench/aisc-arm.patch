@@ -0,0 +1,41 @@
+#!/usr/bin/env node
+// Runs the AISC reference solutions: pilot checks 1-6 (verifier accepts solve-aisc.sh,
+// rejects the wrong states) and the deterministic references for expansion tasks 7-13.
+// Usage: npm run aisc:check -- --aisc-bin <aisc> --aisc-skill-dir <skills/aisc> [--but-bin <but>] [--version-pins <file>]
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { parseArgs } from "./lib/args.mjs";
+import { run } from "./lib/process.mjs";
+import { SCENARIO_TASKS } from "./lib/scenarios.mjs";
+
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const args = parseArgs(process.argv.slice(2));
+if (!args.has("aisc-bin") || !args.has("aisc-skill-dir")) {
+  console.error("Usage: npm run aisc:check -- --aisc-bin <aisc> --aisc-skill-dir <dir> [--but-bin <but>] [--version-pins <file>] [--tasks pilot,scenario]");
+  process.exit(2);
+}
+const aiscBin = path.resolve(args.get("aisc-bin"));
+const skillDir = path.resolve(args.get("aisc-skill-dir"));
+const phases = new Set((args.get("tasks") ?? "pilot,scenario").split(","));
+const butArgs = args.has("but-bin") ? ["--but-bin", path.resolve(args.get("but-bin"))] : [];
+const passthrough = ["but-bin", "jj-bin", "version-pins"].filter(name => args.has(name)).flatMap(name => [`--${name}`, path.resolve(args.get(name))]);
+
+if (phases.has("pilot")) {
+  for (const suffix of ["", "2", "3", "4", "5", "6"]) {
+    console.log(`pilot${suffix}:check (aisc)`);
+    run("node", [`scripts/run-pilot${suffix}-checks.mjs`, "--aisc-bin", aiscBin, ...butArgs], { cwd: repoRoot, stdio: "inherit", timeoutMs: 600000 });
+  }
+}
+if (phases.has("scenario")) {
+  const out = mkdtempSync(path.join(tmpdir(), "vcb-aisc-ref-"));
+  try {
+    for (const task of SCENARIO_TASKS) {
+      console.log(`${task.id} reference (aisc+skill)`);
+      run("node", ["scripts/run-pilot-agent.mjs", "--task", task.id, "--arm", "aisc+skill", "--reference", "true",
+        "--aisc-bin", aiscBin, "--aisc-skill-dir", skillDir, ...passthrough, "--out", path.join(out, task.id)], { cwd: repoRoot, stdio: "inherit", timeoutMs: 600000 });
+    }
+  } finally { rmSync(out, { recursive: true, force: true }); }
+}
+console.log(JSON.stringify({ passed: true }));
