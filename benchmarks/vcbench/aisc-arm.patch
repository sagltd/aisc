+// Held-out 11: name the files one commit changed, without changing anything.
+import { commands, write, initialize, save, adopt, refs, disk, same, result, residue, BASE } from './heldout-common.mjs';
+export const ID = 'heldout-11-commit-files';
+const SUBJECT = 'Refactor upload client';
+const ANSWER = ['docs/upload.md', 'src/upload-retry.ts', 'src/upload.ts'];
+const DECOYS = ['src/app.ts', 'src/config.ts', 'README.md', 'docs/api.md', 'src/upload-log.ts'];
+const HISTORY = [
+  ['Add upload client', { 'src/upload.ts': 'export const upload = (path: string) => path;\n' }],
+  ['Document uploads', { 'docs/upload.md': 'Uploads go to /upload.\n' }],
+  [SUBJECT, { 'src/upload.ts': 'export function upload(path: string) {\n  return path;\n}\n', 'src/upload-retry.ts': 'export const retries = 2;\n', 'docs/upload.md': 'Uploads go to /upload and retry twice.\n' }],
+  ['Log uploads', { 'src/upload-log.ts': 'export const log = (path: string) => path;\n', 'src/app.ts': 'export const name = "service"; // uploads\n' }],
+  ['Bump upload retries', { 'src/upload-retry.ts': 'export const retries = 3;\n' }],
+];
+function prepare(ctx) {
+  initialize(ctx, BASE); const { g } = commands(ctx);
+  for (const [subject, files] of HISTORY) { write(ctx.repoDir, files); save(ctx, subject); }
+  adopt(ctx, 'main');
+  return { refs: refs(ctx), files: disk(ctx.repoDir), index: g('ls-files', '--stage') };
+}
+// Every changed path appears in the reply and no unchanged path does; formatting is free.
+const answered = response => {
+  const text = String(response ?? '');
+  return ANSWER.every(p => text.includes(p)) && DECOYS.every(p => !text.includes(p));
+};
+function verify(ctx) {
+  const { g } = commands(ctx), m = ctx.metadata;
+  return result({
+    response_correct: answered(ctx.response),
+    refs_unchanged: same(refs(ctx), m.refs),
+    files_unchanged: same(disk(ctx.repoDir), m.files),
+    index_unchanged: ctx.arm === 'but+skill' || g('ls-files', '--stage') === m.index,
+    no_residue: residue(ctx),
+  });
+}
+function solve(ctx) {
+  const { g } = commands(ctx);
+  return g('show', '--name-only', '--format=', `:/${SUBJECT}`);
+}
+export default { id: ID, researchRank: 111, prepare, verify, solve };
