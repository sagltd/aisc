+// Held-out 6: commit one uncommitted change onto another existing branch without leaving this one.
+import { commands, write, initialize, save, adopt, refs, exactTree, disk, same, result, active, residue, BASE, subjects, authorsKept, othersUnchanged, pending, gitLike } from './heldout-common.mjs';
+export const ID = 'heldout-6-commit-elsewhere';
+const FIX = { 'src/config.ts': 'export const port = 3000;\nexport const MAX_RETRIES = 3;\n' };
+const UI = { 'src/ui.ts': 'export const theme = "dark";\nexport const compact = true;\n' };
+function prepare(ctx) {
+  initialize(ctx, BASE); const { g } = commands(ctx);
+  g('switch', '-c', 'hotfix'); write(ctx.repoDir, { 'CHANGELOG.md': '## Unreleased\n' }); save(ctx, 'Prepare hotfix');
+  g('switch', '-q', 'main'); g('switch', '-c', 'feature-ui'); write(ctx.repoDir, { 'src/ui.ts': 'export const theme = "dark";\n' }); save(ctx, 'Add theme toggle');
+  const enc = files => Object.fromEntries(Object.entries(files).map(([p, t]) => [p, { mode: '100644', bytes: Buffer.from(t).toString('base64') }]));
+  const metadata = { refs: refs(ctx), hotfixTree: { ...exactTree(ctx, 'hotfix'), ...enc(FIX) } };
+  adopt(ctx, 'feature-ui', ['hotfix']);
+  const committed = disk(ctx.repoDir);
+  write(ctx.repoDir, { ...FIX, ...UI });
+  // Git-like arms: the fix leaves this branch's work tree. But: every applied branch is in the
+  // workspace, so the fix stays on disk, committed on hotfix.
+  metadata.expectedDisk = gitLike(ctx.arm) ? { ...committed, ...enc(UI) } : disk(ctx.repoDir);
+  return metadata;
+}
+function verify(ctx) {
+  const m = ctx.metadata;
+  const ok = subjects(ctx, 'hotfix').join('|') === 'Fix default port|Prepare hotfix';
+  return result({
+    fix_committed_on_hotfix: ok && same(exactTree(ctx, 'hotfix'), m.hotfixTree),
+    authors_kept: authorsKept(ctx, 'hotfix'),
+    feature_ui_unchanged: othersUnchanged(ctx, m.refs, ['hotfix']),
+    files_on_disk_match: same(disk(ctx.repoDir), m.expectedDisk),
+    ui_edit_uncommitted: pending(ctx, ['src/ui.ts']),
+    same_branch: active(ctx, 'feature-ui', ['hotfix']),
+    no_residue: residue(ctx),
+  });
+}
+function solve(ctx) {
+  const { g, b, a, execute } = commands(ctx);
+  if (ctx.arm === 'git') {
+    // A temporary index on hotfix, so this branch's work tree and index are never touched.
+    const tmp = `${ctx.repoDir}/.git/hotfix-index`, env = { ...(ctx.env ?? process.env), GIT_INDEX_FILE: tmp };
+    commands({ ...ctx, env }).g('read-tree', 'hotfix');
+    const blob = g('hash-object', '-w', 'src/config.ts');
+    commands({ ...ctx, env }).g('update-index', '--cacheinfo', `100644,${blob},src/config.ts`);
+    const tree = commands({ ...ctx, env }).g('write-tree');
+    const commit = g('commit-tree', tree, '-p', 'hotfix', '-m', 'Fix default port');
+    g('update-ref', 'refs/heads/hotfix', commit); g('checkout', '--', 'src/config.ts');
+    execute('rm', ['-f', tmp]);
+  } else if (ctx.arm === 'aisc+skill') {
+    a('commit', '-b', 'hotfix', '--onto', 'hotfix', '--existing', '-m', 'Fix default port', 'src/config.ts');
+  } else {
+    const id = JSON.parse(b('status', '--json')).uncommittedChanges.find(c => c.filePath === 'src/config.ts').cliId;
+    b('commit', '-b', 'hotfix', '-m', 'Fix default port', id);
+  }
+}
+export default { id: ID, researchRank: 106, prepare, verify, solve };
