+    messages_fixed: same(subjects(ctx, 'fix-auth'), WANT),
+    contents_unchanged: [0, 1, 2].every(k => g('rev-parse', `fix-auth~${k}^{tree}`) === m.trees[k]),
+    authors_kept: authorsKept(ctx, 'fix-auth'),
+    other_refs_unchanged: othersUnchanged(ctx, m.refs, ['fix-auth']),
+    files_on_disk_unchanged: same(disk(ctx.repoDir), m.expectedDisk),
+    readme_edit_uncommitted: pending(ctx, ['README.md']),
+    same_branch: active(ctx, 'fix-auth'),
+    no_residue: residue(ctx),
+  });
+}
+function solve(ctx) {
+  const { g, b, a } = commands(ctx);
