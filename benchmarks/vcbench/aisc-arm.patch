+        file: (s.uncommittedChanges ?? []).find(c => c.filePath === 'tests/parser.test.ts') };
+    };
+    const first = look(); b('amend', '-t', first.commit.cliId, first.file.cliId);
+    b('reword', look().commit.cliId, '-m', 'Add parser with tests');
