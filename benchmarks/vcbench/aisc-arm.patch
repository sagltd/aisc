+  write(ctx.repoDir, { 'src/cache.ts': 'export const cache = new Map<string, string>();\n' }); save(ctx, 'Add token cache');
+  write(ctx.repoDir, { 'src/auth.ts': 'export function refresh(token: string) {\n  return token.trim();\n}\n' }); save(ctx, 'Fix tokne refresh');
+  write(ctx.repoDir, { 'tests/auth.test.ts': 'import { refresh } from "../src/auth";\nif (refresh(" a ") !== "a") throw new Error("refresh");\n' }); save(ctx, 'Add auth tests');
+  const metadata = { refs: refs(ctx), trees: [0, 1, 2].map(k => g('rev-parse', `fix-auth~${k}^{tree}`)) };
+  adopt(ctx, 'fix-auth');
+  write(ctx.repoDir, { 'README.md': 'Service example.\nAuth refresh notes (draft).\n' });
+  metadata.expectedDisk = disk(ctx.repoDir);
+  return metadata;
+}
+function verify(ctx) {
+  const { g } = commands(ctx), m = ctx.metadata;
