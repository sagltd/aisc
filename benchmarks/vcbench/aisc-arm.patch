diff --git a/scripts/lib/disk.mjs b/scripts/lib/disk.mjs
new file mode 100644
index 0000000..d40d43d
--- /dev/null
+++ b/scripts/lib/disk.mjs
@@ -0,0 +1,66 @@
+import { lstatSync, readdirSync, realpathSync } from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+
+// Disk footprint of a trial: bytes a user pays to have the workspace (including
+// .git/.jj), every linked Git worktree outside it, and tool data directories
+// such as GitButler's app data. Symlinks are never followed; hard-linked files
+// are counted once. `allocated` is st_blocks * 512, `apparent` is st_size.
+export function measurePaths(paths) {
+  const seen = new Set();
+  let apparent = 0, allocated = 0, files = 0;
+  const visit = target => {
+    let stat;
+    try { stat = lstatSync(target); } catch { return; }
+    if (stat.isDirectory()) {
+      allocated += (stat.blocks ?? 0) * 512;
+      let names = [];
+      try { names = readdirSync(target); } catch { /* unreadable directory counts as empty */ }
+      for (const name of names) visit(path.join(target, name));
+      return;
+    }
+    const key = `${stat.dev}:${stat.ino}`;
+    if (stat.nlink > 1) {
+      if (seen.has(key)) return;
+      seen.add(key);
+    }
+    files++;
+    apparent += stat.size;
+    allocated += (stat.blocks ?? 0) * 512;
+  };
+  for (const target of paths) visit(target);
+  return { apparent_bytes: apparent, allocated_bytes: allocated, file_count: files };
+}
+
+// Linked worktrees outside the workspace, from `git worktree list --porcelain`.
+export function linkedWorktrees(workspace, gitBin = 'git', env = process.env) {
+  const listed = spawnSync(gitBin, ['-C', workspace, 'worktree', 'list', '--porcelain'], { encoding: 'utf8', env });
+  if (listed.status !== 0) return [];
+  const root = realpathSync(workspace);
+  return listed.stdout.split('\n').filter(line => line.startsWith('worktree ')).map(line => line.slice(9))
+    .filter(dir => {
+      try { return realpathSync(dir) !== root && !realpathSync(dir).startsWith(root + path.sep); } catch { return false; }
+    });
+}
+
+export function snapshotDisk({ workspace, gitBin = 'git', env = process.env, extraDirs = [] }) {
+  const worktrees = linkedWorktrees(workspace, gitBin, env);
+  const targets = [workspace, ...worktrees, ...extraDirs.filter(Boolean)];
+  return { ...measurePaths(targets), worktree_count: worktrees.length };
+}
+
+// Result block: disk.{before,after,delta}_{apparent,allocated}_bytes.
+export function diskDelta(before, after) {
+  return {
+    before_apparent_bytes: before.apparent_bytes,
+    after_apparent_bytes: after.apparent_bytes,
+    delta_apparent_bytes: after.apparent_bytes - before.apparent_bytes,
+    before_allocated_bytes: before.allocated_bytes,
+    after_allocated_bytes: after.allocated_bytes,
+    delta_allocated_bytes: after.allocated_bytes - before.allocated_bytes,
+    before_file_count: before.file_count,
+    after_file_count: after.file_count,
+    linked_worktrees_before: before.worktree_count,
+    linked_worktrees_after: after.worktree_count,
+  };
+}
