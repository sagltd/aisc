+    stacked_branch_exists: exists,
+    one_commit_above_feature_api: exists && same(subjects(ctx, 'feature-api-tests', 'feature-api'), ['Add API tests']) && parent === m.apiRef,
+    test_committed: exists && same(exactTree(ctx, 'feature-api-tests'), m.wantTree),
+    authors_kept: exists && authorsKept(ctx, 'feature-api-tests'),
+    other_refs_unchanged: othersUnchanged(ctx, m.refs, ['feature-api-tests']),
+    files_on_disk_unchanged: same(disk(ctx.repoDir), m.expectedDisk),
+    docs_edit_uncommitted: pending(ctx, ['docs/api.md']),
+    on_new_branch: active(ctx, 'feature-api-tests', ['feature-api']),
+    no_residue: residue(ctx),
+  });
+}
+function solve(ctx) {
+  const { g, b, a } = commands(ctx);
+  if (ctx.arm === 'git') { g('switch', '-q', '-c', 'feature-api-tests'); g('add', 'tests/api.test.ts'); g('commit', '-q', '-m', 'Add API tests'); }
+  else if (ctx.arm === 'aisc+skill') a('commit', '-b', 'feature-api-tests', '-m', 'Add API tests', 'tests/api.test.ts');
+  else {
+    b('branch', 'new', 'feature-api-tests', '--above', 'feature-api');
+    const file = JSON.parse(b('status', '--json')).uncommittedChanges.find(c => c.filePath === 'tests/api.test.ts');
+    b('commit', '-b', 'feature-api-tests', '-m', 'Add API tests', file.cliId);
+  }
+}
+export default { id: ID, researchRank: 109, prepare, verify, solve };
