+    wantUiTree: { ...exactTree(ctx, 'feature-ui'), ...enc(PARSER_FIX) }, wantDocsTree: { ...exactTree(ctx, 'main'), ...enc(DOC) } };
+  adopt(ctx, 'feature-ui');
