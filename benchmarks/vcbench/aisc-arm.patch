+// Held-out 5: find which commit first set a value, without changing anything.
+import { commands, write, initialize, save, adopt, refs, disk, same, result, residue, BASE } from './heldout-common.mjs';
+export const ID = 'heldout-5-find-commit';
+const ANSWER = 'Raise retry limit for flaky uploads';
+const HISTORY = [
+  ['Add upload client', { 'src/upload.ts': 'export const upload = (path: string) => path;\n' }],
+  ['Document configuration', { 'docs/config.md': 'Retries default to 3.\n' }],
+  [ANSWER, { 'src/config.ts': 'export const port = 8080;\nexport const MAX_RETRIES = 7;\n' }],
+  ['Rename port setting', { 'src/config.ts': 'export const port = 8080; // http\nexport const MAX_RETRIES = 7;\n' }],
+  ['Retry uploads once more', { 'src/config.ts': 'export const port = 8080; // http\nexport const MAX_RETRIES = 9;\n' }],
+  ['Restore retry limit', { 'src/config.ts': 'export const port = 8080; // http\nexport const MAX_RETRIES = 7;\n' }],
+];
+function prepare(ctx) {
+  initialize(ctx, BASE); const { g } = commands(ctx);
+  for (const [subject, files] of HISTORY) { write(ctx.repoDir, files); save(ctx, subject); }
+  adopt(ctx, 'main');
+  return { refs: refs(ctx), files: disk(ctx.repoDir), index: g('ls-files', '--stage') };
+}
+const answered = response => {
+  const text = String(response ?? '').trim().replace(/^[`"'*\s]+|[`"'*.\s]+$/g, '');
+  return text === ANSWER || text.split('\n').some(line => line.trim().replace(/^[`"'*\-\s]+|[`"'*.\s]+$/g, '') === ANSWER);
+};
+function verify(ctx) {
+  const { g } = commands(ctx), m = ctx.metadata;
+  return result({
+    response_correct: answered(ctx.response),
+    refs_unchanged: same(refs(ctx), m.refs),
+    files_unchanged: same(disk(ctx.repoDir), m.files),
+    index_unchanged: ctx.arm === 'but+skill' || g('ls-files', '--stage') === m.index,
+    no_residue: residue(ctx),
+  });
+}
+function solve(ctx) {
+  const { g } = commands(ctx);
+  return g('log', '--reverse', '--format=%s', '-S', 'MAX_RETRIES = 7', 'main').split('\n')[0];
+}
+export default { id: ID, researchRank: 105, prepare, verify, solve };
