new file mode 100644
index 0000000..d9ba0b5
--- /dev/null
+++ b/scripts/check-disk.mjs
@@ -0,0 +1,49 @@
+#!/usr/bin/env node
+import assert from 'node:assert/strict';
+import { linkSync, lstatSync, mkdirSync, mkdtempSync, realpathSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { diskDelta, linkedWorktrees, measurePaths, snapshotDisk } from './lib/disk.mjs';
+
+const root = realpathSync(mkdtempSync(path.join(tmpdir(), 'vcb-disk-')));
+try {
+  const dir = path.join(root, 'plain');
+  mkdirSync(dir);
+  writeFileSync(path.join(dir, 'a.txt'), 'x'.repeat(1000));
+  writeFileSync(path.join(dir, 'empty'), '');
+  linkSync(path.join(dir, 'a.txt'), path.join(dir, 'hard.txt'));
+  symlinkSync(root, path.join(dir, 'loop'));
+  const plain = measurePaths([dir]);
+  assert.equal(plain.apparent_bytes, 1000 + lstatSync(path.join(dir, 'loop')).size, 'hard links count once; a symlink counts as itself, never its target');
+  assert.equal(plain.file_count, 3);
+  assert.ok(plain.allocated_bytes >= 1000, 'allocated bytes cover at least the content');
+
+  const git = (cwd, ...args) => {
+    const result = spawnSync('git', args, { cwd, encoding: 'utf8', env: { ...process.env, GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_NOSYSTEM: '1' } });
+    assert.equal(result.status, 0, result.stderr);
+  };
+  const repo = path.join(root, 'repo');
+  mkdirSync(repo);
+  git(repo, 'init', '-b', 'main');
+  writeFileSync(path.join(repo, 'f.txt'), 'content\n');
+  git(repo, 'add', 'f.txt');
+  git(repo, '-c', 'user.name=T', '-c', 'user.email=t@example.test', 'commit', '-m', 'init');
+  assert.deepEqual(linkedWorktrees(repo), []);
+  const before = snapshotDisk({ workspace: repo });
+  const sibling = path.join(root, 'sibling');
+  git(repo, 'worktree', 'add', '-b', 'topic', sibling);
+  const appData = path.join(root, 'app-data');
+  mkdirSync(appData);
+  writeFileSync(path.join(appData, 'state'), 'y'.repeat(5000));
+  assert.deepEqual(linkedWorktrees(repo), [sibling]);
+  const after = snapshotDisk({ workspace: repo, extraDirs: [appData, null] });
+  const delta = diskDelta(before, after);
+  for (const key of ['before', 'after', 'delta']) for (const kind of ['apparent', 'allocated']) {
+    assert.ok(Number.isFinite(delta[`${key}_${kind}_bytes`]), `${key}_${kind}_bytes`);
+  }
+  assert.ok(delta.delta_apparent_bytes >= 5000 + 'content\n'.length, 'sibling worktree and tool data are counted');
+  assert.equal(delta.linked_worktrees_before, 0);
+  assert.equal(delta.linked_worktrees_after, 1);
+  console.log(JSON.stringify({ passed: true, delta_apparent_bytes: delta.delta_apparent_bytes }, null, 2));
+} finally { rmSync(root, { recursive: true, force: true }); }
