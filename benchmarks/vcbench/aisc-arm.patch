+// Held-out 9: a new branch stacked on this one, with one of the uncommitted changes committed there.
+import { commands, write, initialize, save, adopt, refs, exactTree, disk, same, result, active, residue, BASE, subjects, authorsKept, othersUnchanged, pending } from './heldout-common.mjs';
+export const ID = 'heldout-9-stack-branch';
+const enc = files => Object.fromEntries(Object.entries(files).map(([p, t]) => [p, { mode: '100644', bytes: Buffer.from(t).toString('base64') }]));
+const ROUTES = { 'src/routes.ts': 'export const routes = ["/items"];\n' };
+const TEST = { 'tests/api.test.ts': 'import { routes } from "../src/routes";\nif (!routes.includes("/items")) throw new Error("routes");\n' };
+const DOCS = { 'docs/api.md': '# API\n\nGET /items lists items.\n\nTests live in tests/.\n' };
+function prepare(ctx) {
+  initialize(ctx, BASE); const { g } = commands(ctx);
+  g('switch', '-c', 'feature-api'); write(ctx.repoDir, ROUTES); save(ctx, 'Add API routes');
+  const metadata = { refs: refs(ctx), apiRef: g('rev-parse', 'feature-api'), wantTree: { ...exactTree(ctx, 'feature-api'), ...enc(TEST) } };
+  adopt(ctx, 'feature-api');
+  write(ctx.repoDir, { ...TEST, ...DOCS });
+  metadata.expectedDisk = disk(ctx.repoDir);
+  return metadata;
+}
+function verify(ctx) {
+  const { execute } = commands(ctx), m = ctx.metadata;
+  const exists = !!refs(ctx)['feature-api-tests'];
+  const parent = exists ? execute('git', ['rev-parse', 'feature-api-tests~1'], false).stdout.trim() : '';
